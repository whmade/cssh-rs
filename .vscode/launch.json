    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'cssh-rs'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=cssh-rs",
                    "--package=cssh-rs"
                ],
                "filter": {
                    "name": "cssh-rs",
                    "kind": "bin"
                }
            },
            "args": ["-u", "test", "hostname1", "hostname2"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'cssh-rs-daemon'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=cssh-rs",
                    "--package=cssh-rs"
                ],
                "filter": {
                    "name": "cssh-rs",
                    "kind": "bin"
                }
            },
            "args": ["daemon", "-u", "test", "hostname1", "hostname2"],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug executable 'cssh-rs'",
            "cargo": {
                "args": [
                    "build",
                    "--bin=cssh-rs",
                    "--package=cssh-rs"
                ],
                "filter": {
                    "name": "cssh-rs",
                    "kind": "bin"
                }
            },
            "args": ["client", "-u", "test", "hostname"],
            "cwd": "${workspaceFolder}"
        }
    ]
}