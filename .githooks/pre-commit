#!/bin/bash
set -e

# Git launches hooks with a sanitized PATH (MSYS2 default on Windows),
# stripping the user's ~/.cargo/bin. Restore it.
CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
if [ -f "$CARGO_HOME/env" ]; then
    # shellcheck disable=SC1091
    . "$CARGO_HOME/env"
elif [ -d "$CARGO_HOME/bin" ]; then
    case ":$PATH:" in
        *":$CARGO_HOME/bin:"*) ;;
        *) PATH="$CARGO_HOME/bin:$PATH" ;;
    esac
fi

# cssh-rs builds only for Windows, so every host checks its release target.
target=x86_64-pc-windows-msvc
cargo fmt
cargo xtask cross-lint "$target"
cargo xtask check-typography
cargo xtask cross-build "$target" -- --workspace --all-targets
cargo xtask cross-doc "$target"
case "$(uname -s)" in
    MINGW* | MSYS* | CYGWIN*) cargo xtask update-readme-help ;;
    *) echo "Skipping cargo xtask update-readme-help: it runs cssh-rs, which needs a Windows host." ;;
esac
